{
  "name": "@heliopause/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "SvelteKit console. Built to static files; the manager and workstation serve the same build. Does not import the heliopause library.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "prepare": "svelte-kit sync",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@heliopause/i18n": "file:../i18n"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  }
}
