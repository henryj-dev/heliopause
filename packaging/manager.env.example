# Required manager configuration. TLS private keys should be mounted files, never values here.
HELIOPAUSE_MANAGER_PORT=8444
HELIOPAUSE_MANAGER_HOST=0.0.0.0

# Optional override for the SvelteKit console at /app. Unset uses
# <bin>/../packages/web/build when that tree contains index.html — the image
# copies the build there, so /app is on without this variable.
# HELIOPAUSE_WEB_ROOT=/opt/heliopause/packages/web/build
HELIOPAUSE_RELAYS=dev=https://10.17.0.1:8443=/pki/dev
HELIOPAUSE_CERT_FILE=/pki/server.pem
HELIOPAUSE_KEY_FILE=/pki/server.key
HELIOPAUSE_CA_FILE=/pki/ca.pem
HELIOPAUSE_OPERATOR_CNS=ops-alice
HELIOPAUSE_WRITER_CNS=ops-alice,ops-review

# Standalone token/CSR/certificate database. Parent directory must be writable by UID 10001.
# Before first start, run exactly once as that UID:
#   node /opt/heliopause/bin/heliopause-enrollment.ts init /var/lib/heliopause/enrollment.json
# Manager startup refuses missing/malformed state and never recreates a deleted revocation ledger.
HELIOPAUSE_ENROLLMENT_STORE=/var/lib/heliopause/enrollment.json

# name=public-CA-file. The CA private key is never mounted into the manager.
HELIOPAUSE_ENROLLMENT_TRUSTED_CAS=site=/pki/ca.pem

# May be the enrollment store itself. Relays need a securely replicated read-only copy of this file.
HELIOPAUSE_REVOCATION_FILE=/var/lib/heliopause/enrollment.json

# ── artifact signing (required — the manager exits 2 without it) ───────────────
#
# The online Ed25519 private key that authorises approved artifacts. It is what an agent verifies
# before touching its firewall, so it is the second half of the two-person control: the approval
# says a human agreed, this says the bytes reaching the host are the ones they agreed to. A relay
# never holds it — the relay carries the signed bundle and cannot mint one.
#
# Read once at startup, and startup refuses it unless it is a regular non-symlink file that is not
# readable or writable by group/other and is owned by the account running the manager. It also has
# to parse as an Ed25519 private key: the check happens **before** the listening socket opens, so a
# wrong key is a manager that does not come up rather than one that fails at the first publish.
#
# The public half goes into every agent's HELIOPAUSE_MANAGER_SIGNING_KEYS_DIR. Rotation is therefore
# an add-then-remove: publish the new public key to every agent's ring first, switch this file, and
# only then drop the old public key — the agent trusts a set, not a single key, so the two orders
# differ by whether there is a window where nothing it trusts is signing.
HELIOPAUSE_ARTIFACT_SIGNING_KEY_FILE=/etc/heliopause/artifact-signing.key

# How long an authorisation stays valid once signed. Default 86400; the protocol clamps it to
# 15 minutes..7 days. Shorter means a captured bundle stops being replayable sooner and that a host
# which was offline for longer than this needs a re-publish rather than applying stale intent.
#HELIOPAUSE_ARTIFACT_AUTHORIZATION_TTL_SEC=86400

# ── browser login (optional — unset leaves the console certificate-only) ──────
#
# Setting HELIOPAUSE_OIDC_ISSUER switches it on and makes the rest required, so a half
# configuration fails at startup rather than at the moment somebody tries to sign in.
#
# This adds a second way to *arrive*, never a second way to decide what you may do: the decision
# still produces a name in the same space HELIOPAUSE_OPERATOR_CNS uses. A writer additionally needs
# an alias into that space, because the two-person rule compares proposer and approver as strings
# and one human under two names would satisfy it alone.
#HELIOPAUSE_OIDC_ISSUER=https://idp.example.com
#HELIOPAUSE_OIDC_CLIENT_ID=heliopause-manager
#HELIOPAUSE_OIDC_CLIENT_SECRET_FILE=/etc/heliopause/oidc-client-secret
#HELIOPAUSE_OIDC_REDIRECT_URI=https://heliopause.example.com/auth/callback
#HELIOPAUSE_OIDC_OPERATOR_ROLES=heliopause-operators
#HELIOPAUSE_OIDC_WRITER_ROLES=heliopause-writers
#HELIOPAUSE_OIDC_ALIASES=someone@example.com=ops-alice
# The `events` key this deployment's IdP puts a role change under. Required, and deliberately not
# defaulted: RFC 8417 leaves it to the issuer, and a default naming one provider makes every other
# one discard authority changes *silently* — the token verifies, the key does not match.
#HELIOPAUSE_OIDC_ROLE_CHANGE_EVENT=https://idp.example.com/events/role-change
# Roles that may approve a plan they proposed themselves. This switches off the two-person rule for
# the identities named here, so the one-time code below is not optional when it is set.
#HELIOPAUSE_OIDC_SOLO_ROLES=
# Session lifetime. Group claims are captured at login, so this is also how stale they may get.
# Bounded to 60..2592000; an unreadable value used to mean Invalid Date, which never expires.
#HELIOPAUSE_OIDC_SESSION_TTL_SEC=28800

# 🔴 **Two URIs have to be registered at the identity provider, not here.**
#
#   Redirect URI              https://<console>/auth/callback
#   Back-channel Logout URI   https://<console>/auth/backchannel-logout
#
# The second one is the one that gets forgotten, and the failure is quiet in a specific direction.
# Leave it blank and an administrator's force-logout reaches nobody: the IdP reports a successful
# logout and every session here keeps working, including one that may approve and publish. The route
# exists and is verified; only the registration is missing.
#
# Register it with `backchannel_logout_session_required` **off**. The manager acts on `sub` and
# ignores `sid` deliberately — "end this person's session" is true of every session they hold,
# including one in a browser they have forgotten about.
#
# To confirm it landed, force a logout at the IdP and look for this line in the manager's journal:
#
#     [manager] backchannel-logout for sub <id>: N session(s) ended
#
# No line at all means the URI is still not registered. A refusal line means it is registered and
# the token was rejected — which names the reason.

# ── one-time codes (optional, and required when SOLO_ROLES is set) ────────────
#
# Applies to both ways of arriving: a browser session and a client certificate. A certificate
# carries no IdP identity, so HELIOPAUSE_OTP_USERS maps a certificate name to a KeyStone user id.
# A writer with no entry cannot approve — refused with a message naming the missing mapping.
#HELIOPAUSE_OTP_ISSUER_URL=https://idp.example.com
#HELIOPAUSE_OTP_SERVICE_TOKEN_FILE=/etc/heliopause/otp-service-token
#HELIOPAUSE_OTP_USERS=ops-alice=00000000-0000-4000-8000-000000000000
