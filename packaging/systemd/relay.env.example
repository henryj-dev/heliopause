# /etc/heliopause/relay.env — 0640 root:root
#
# The three PKI paths are **not** here: the unit passes them through `LoadCredential`, because
# `DynamicUser=yes` means there is no fixed UID to own the private key. Setting them here would
# override the credential paths and hand the transient user a file it cannot read.

# Where generations land. Two ways in, and both stay:
#
#   1. `POST /publish` from the manager — the ordinary path, gated by the approval rule
#   2. writing this directory directly over ssh — the escape hatch for when the manager is the thing
#      that is broken (결정 5)
#
# The unit makes it writable through `StateDirectory=heliopause`, which relocates the real data to
# `/var/lib/private/heliopause` and leaves this path as a symlink systemd maintains. Keep the value as
# written — it resolves through the link.
HELIOPAUSE_ARTIFACT_DIR=/var/lib/heliopause/artifacts

HELIOPAUSE_RELAY_PORT=8443

# The private address only. Binding `::` would put the relay on this host's public interface, and
# the agents that use it are all inside the VPC — the default exists for the test harness, not for
# a gateway with a public IP.
HELIOPAUSE_RELAY_HOST=10.17.0.1

# How often the artifact directory is re-read. Polled rather than pushed: a webhook would require
# the gateway to be reachable from outside, which is the inbound path this design removed.
HELIOPAUSE_RELOAD_SEC=30

# Certificate CNs allowed to read /status, comma-separated. **Unset disables the endpoint.**
#
# That default is deliberate. A fleet-wide view names every host, its generation, and whether its
# ruleset has drifted — for anyone who has taken one host that is a target list plus a note on which
# targets are currently unprotected. So an operator is named explicitly rather than any valid
# certificate being trusted; agents hold valid certificates too.
#
#   heliopause-pki issue ./pki <name> --role=operator
#
# HELIOPAUSE_OPERATOR_CNS=ops-alice

# Certificate CNs allowed to `POST /publish`, comma-separated. **Unset disables the endpoint**, which
# is the right default and not a degraded one: generations can still arrive by writing
# `HELIOPAUSE_ARTIFACT_DIR` directly, and that path is deliberately kept as the way to publish when
# the manager is the thing that is broken.
#
# ## Why this is a separate list from HELIOPAUSE_OPERATOR_CNS
#
# Reading the fleet and changing the firewall are different powers, and the second is strictly larger.
# Every operator certificate that exists can read `/status`; if that same list could also write, then
# issuing a read-only credential — for a dashboard, for a colleague who needs to look without
# touching — would silently hand out publish rights.
#
# Normally this holds one name: the manager's own identity, not a person's. A human who needs to
# publish without the manager has ssh to this gateway, and that is the escape hatch above.
#
# HELIOPAUSE_PUBLISHER_CNS=hp-manager

# Minimal denylist replicated from the manager. The separate locked writer account owns this path;
# relay can read it but cannot rename, truncate, chmod, or unlink it. It must be initialized exactly
# once before the writer socket and relay are enabled; neither process recreates a missing file.
HELIOPAUSE_REVOCATION_FILE=/var/lib/heliopause-revocations/revocations.json
HELIOPAUSE_REVOCATION_WRITER_SOCKET=/run/heliopause-revocation-writer.sock
