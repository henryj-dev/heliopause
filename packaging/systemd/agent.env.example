# /etc/heliopause/agent.env — 0640 root:root
#
# systemd parses this itself; there is no shell. So no quoting is applied, no variable expansion
# happens, and a trailing comment on a value line becomes part of the value.

# The local gateway's relay. Must be https — the agent refuses anything else at startup rather
# than falling back, because the ruleset it fetches decides what this host accepts.
HELIOPAUSE_RELAY_URL=https://10.17.0.1:8443

# What this host reports as, and what its client certificate must carry as its subject CN. The
# relay compares the two and rejects a mismatch with 403: without that, any host holding a valid
# certificate could claim to be any other host and collect its ruleset.
HELIOPAUSE_HOST_ID=k3s-01.dev

HELIOPAUSE_CA_FILE=/etc/heliopause/pki/ca.pem
HELIOPAUSE_CERT_FILE=/etc/heliopause/pki/agent.pem
HELIOPAUSE_KEY_FILE=/etc/heliopause/pki/agent.key

# ── the signed-artifact path (required — the agent exits 2 without all three) ──
#
# Which relay/VPC this host belongs to, pinned here rather than inferred from the relay it happens
# to be talking to. Every authorisation the manager signs names its target, and the agent refuses a
# payload whose target is not this one — so a generation approved for another VPC cannot be replayed
# here by anything sitting between them, including a relay that has been taken over.
#
# It must match the manager's `HELIOPAUSE_RELAYS` name for this VPC exactly.
HELIOPAUSE_TARGET=dev
#
# The two trust rings, kept apart on purpose. The manager's online key signs day-to-day generations;
# the break-glass keys are offline and carry a much shorter maximum authorisation lifetime, so a
# leaked online key cannot mint the long-lived emergency authorisations and vice versa. Each is a
# directory of Ed25519 **public** keys, non-symlink and not group/world writable, and the agent
# reads both at startup — a wrong mode or a non-Ed25519 file stops it there rather than during the
# next rollout.
#
# Both are required even when break-glass is not in use: the ring may hold a single key, but "no
# directory" and "an empty ring" are the same to a verifier and would leave the agent unable to
# distinguish an unconfigured host from one that trusts nothing.
HELIOPAUSE_MANAGER_SIGNING_KEYS_DIR=/etc/heliopause/trust/manager
HELIOPAUSE_BREAK_GLASS_KEYS_DIR=/etc/heliopause/trust/break-glass

# ── first enrollment (optional) ──────────────────────────────────────────────
# The enrollment timer creates agent.key locally, submits only its CSR, and polls until an operator
# approves it. The script removes /etc/heliopause/enroll-token itself once the certificate is
# installed; completed state is also durable, so a later timer invocation never submits a second
# request. Pair it with heliopause-agent.path rather than enabling heliopause-agent directly.
#
# The URL is the *manager's* enrollment name — the one in its HELIOPAUSE_PUBLIC_SERVER_NAMES that
# serves POST /infra/node-csrs. Not a dispatcher, not a report-ingest name: a wrong host here answers
# 401, the timer retries forever, and the console shows nothing, which reads as "still pending".
#HELIOPAUSE_ENROLL_URL=https://node-enroll.example
#HELIOPAUSE_ENROLL_TOKEN_FILE=/etc/heliopause/enroll-token
#HELIOPAUSE_PKI_DIR=/etc/heliopause/pki
#HELIOPAUSE_ENROLL_STATE_FILE=/var/lib/heliopause-agent/enrollment.json

# Must be at most half of the site's confirmTimeoutSec. Pull deployments also have a hard 90-second
# confirmation floor covering the bounded nft apply/read-back plus one failed heartbeat retry;
# `defineConfig` and the receiver enforce both constraints.
HELIOPAUSE_INTERVAL_SEC=15

# StateDirectory=heliopause-agent in the unit creates this. Holds the rollback commitment, so an
# agent that cannot write here cannot survive a restart mid-apply.
#
# `heliopause-agent`, **not** `heliopause`. On a gateway the relay reads artifacts under
# /var/lib/heliopause, and this unit's StateDirectoryMode=0700 applied to a shared parent locks the
# relay — which runs as DynamicUser — out of it. Pointing this back at /var/lib/heliopause
# reintroduces that.
HELIOPAUSE_STATE_FILE=/var/lib/heliopause-agent/state.json

# ── the workload half (schema 2) ──────────────────────────────────────────────
#
# Only the node named in `cfg.workload.applier` ever uses these. Every other host receives no
# workload half in its artifact and never runs kubectl, so leaving them unset there is correct —
# not merely harmless. CiliumNetworkPolicy is cluster-scoped, and several agents applying the same
# object means API contention and flapping.
#
# Uncomment on the applier only, together with installing heliopause-agent-applier.conf. There is no
# k3s-admin default: the agent refuses a workload assignment until this dedicated, 0600 credential
# and a local namespace allowlist are present. Its RBAC should be bound only in the namespaces named
# here (see ../kubernetes/heliopause-agent-rbac.yaml).
#HELIOPAUSE_KUBECTL_BIN=/usr/local/bin/kubectl
#HELIOPAUSE_KUBECONFIG=/etc/heliopause/kubeconfig
#HELIOPAUSE_K8S_NAMESPACES=arc-runners,util

# Privileged Cilium service-map telemetry is off by default. Enabling it requires kube-system
# ConfigMap/Pod reads and pods/exec, deliberately absent from the least-privilege RBAC manifest.
# It is not needed to apply or confirm CiliumNetworkPolicy. Grant and enable only after a separate
# security review of that observation path.
#HELIOPAUSE_CILIUM_EXPOSURE=0

# Where kubectl keeps its discovery cache. Defaults to a subdirectory of the state directory above,
# which is deliberate: kubectl's own default is $HOME/.kube/cache and the unit sets ProtectHome=yes,
# so left alone it complains on stderr on every single call. Set this only to move it elsewhere.
#HELIOPAUSE_KUBE_CACHE_DIR=/var/lib/heliopause-agent/kube-cache
