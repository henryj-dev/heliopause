[Unit]
Description=heliopause host certificate enrollment
Documentation=https://github.com/henryj-dev/heliopause
Wants=network-online.target
After=network-online.target
# The token lives under StateDirectory, which is the one place this unit may write. It used to be
# /etc/heliopause/enroll-token, and with ProtectSystem=strict below the script's unlink of the spent
# token could never have succeeded there (EROFS) — the file stayed until its TTL and this condition
# kept the timer firing no-ops. The path must equal HELIOPAUSE_ENROLL_TOKEN_FILE in agent.env;
# src/agent-provisioning.test.ts holds the three copies together.
ConditionPathExists=/var/lib/heliopause-agent/enroll-token

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/heliopause/agent/heliopause-enroll.py
EnvironmentFile=/etc/heliopause/agent.env
# Pending operator approval is a normal state. The timer will poll again without making the unit
# look broken to monitoring or causing systemd's start-rate limiter to suppress later attempts.
SuccessExitStatus=75
User=root
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
StateDirectory=heliopause-agent
StateDirectoryMode=0700
# The script writes the signed certificate under /etc/heliopause/pki and makedirs() it if absent.
# That self-creation is unreachable under ProtectSystem=strict: naming the directory in ReadWritePaths
# makes systemd bind-mount it at namespace setup, which needs it to *already exist* — a fresh host has
# no /etc/heliopause/pki, so the unit died `226/NAMESPACE` before the script ever ran. Measured on the
# first saga onboarding (web-01.dev-icn-vtr, 2026-08-28): every timer fire failed at step NAMESPACE.
# ConfigurationDirectory creates it (and its parent) with the right mode *before* the sandbox is built,
# and makes it writable, so a host that was never touched by hand enrolls on its own. Persistent, not
# reset on stop; contents (the cert) survive.
ConfigurationDirectory=heliopause/pki
ConfigurationDirectoryMode=0700
ReadWritePaths=/var/lib/heliopause-agent
