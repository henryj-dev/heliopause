[Unit]
Description=heliopause host certificate enrollment
Documentation=https://github.com/henryj-dev/heliopause
Wants=network-online.target
After=network-online.target
# The token lives under StateDirectory, which is the one place this unit may write. It used to be
# /etc/heliopause/enroll-token, and with ProtectSystem=strict below the script's unlink of the spent
# token could never have succeeded there (EROFS) — the file stayed until its TTL and this condition
# kept the timer firing no-ops. The path must equal HELIOPAUSE_ENROLL_TOKEN_FILE in agent.env;
# src/agent-provisioning.test.ts holds the three copies together.
ConditionPathExists=/var/lib/heliopause-agent/enroll-token

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/heliopause/agent/heliopause-enroll.py
EnvironmentFile=/etc/heliopause/agent.env
# Pending operator approval is a normal state. The timer will poll again without making the unit
# look broken to monitoring or causing systemd's start-rate limiter to suppress later attempts.
SuccessExitStatus=75
User=root
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
StateDirectory=heliopause-agent
StateDirectoryMode=0700
ReadWritePaths=/etc/heliopause/pki /var/lib/heliopause-agent
