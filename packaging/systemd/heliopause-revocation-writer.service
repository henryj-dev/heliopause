[Unit]
Description=heliopause monotonic revocation snapshot writer
Documentation=https://github.com/henryj-dev/heliopause
Requires=heliopause-revocation-writer.socket
After=heliopause-revocation-writer.socket

[Service]
Type=simple
ExecStartPre=/usr/bin/test -r /var/lib/heliopause-revocations/revocations.json
ExecStart=/usr/bin/node /opt/heliopause/bin/heliopause-revocation-writer.ts
Environment=HELIOPAUSE_REVOCATION_FILE=/var/lib/heliopause-revocations/revocations.json

User=heliopause-revocation-writer
Group=heliopause-revocation-writer
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
UMask=0077

StateDirectory=heliopause-revocations
# The dedicated locked service account owns the directory. The denylist is not a secret: 0755 + a
# 0644 snapshot lets relay read without directory write, rename, chmod, or unlink permission.
StateDirectoryMode=0755

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
MemoryMax=128M
